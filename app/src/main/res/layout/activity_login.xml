<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/boarding_bg_grad"
    tools:context=".LoginActivity">

    <!-- Header: logo + app name + tagline -->
    <LinearLayout
        android:id="@+id/headerLL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardContainer"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:padding="16dp"
            android:src="@drawable/ic_main"
            android:background="@drawable/loader_img" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="HAAi"
            android:fontFamily="@font/nunito_normal"
            android:textFontWeight="700"
            android:textColor="@color/primary_blue_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Health Assistant Artificial Intelligence"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Card: sign-in + detail form -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/curved_bg_container"
        android:elevation="4dp"
        android:padding="24dp"
        android:alpha="0"
        android:translationY="40dp"
        app:layout_constraintTop_toBottomOf="@id/headerLL"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.55">

        <!-- Google Sign-in button (with loading state) -->
        <FrameLayout
            android:id="@+id/googleBtnWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/googleBtnContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/curved_blue_outliner">

                <!-- "G" badge instead of a drawable asset -->
                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/loader_img"
                    android:gravity="center"
                    android:text="G"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/loginWgooleBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continue with Google"
                    android:textColor="@color/primary_blue_dark"
                    android:textStyle="bold"
                    android:textSize="15sp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/googleLoadingPb"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary_blue_dark"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Detail form (revealed after Google sign-in) -->
        <LinearLayout
            android:id="@+id/loginDetailLL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:alpha="0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/emailTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="emailuser@gmail.com"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:background="@drawable/blue_bubble" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Your name"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/nameEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="14dp"
                android:hint="Enter your name"
                android:textSize="15sp"
                android:background="@drawable/curver_outliner"
                android:inputType="textPersonName" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Date of birth &amp; gender"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/dobInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:textSize="15sp"
                    android:hint="DOB"
                    android:background="@drawable/curver_outliner" />

                <TextView
                    android:id="@+id/maleBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Male"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/curver_outliner" />

                <TextView
                    android:id="@+id/femaleBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Female"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/curver_outliner" />

            </LinearLayout>

            <!-- Login button (with its own loading state) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/nextpage"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:text="LOGIN"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary_blue_dark" />

                <ProgressBar
                    android:id="@+id/loginLoadingPb"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/text_white"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>