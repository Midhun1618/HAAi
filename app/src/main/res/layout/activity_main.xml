<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen. Rename this file to match your existing home layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/haai_background"
    android:orientation="vertical">

    <!-- Header: greeting + logout. Stays fixed while content scrolls. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_blue_dark"
        android:foreground="@drawable/wave_fg_overlay"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="56dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">
        <ImageView
            android:id="@+id/gender_icon"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/icon_female"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/greetingTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_normal"
                    android:maxLines="2"
                    android:text="@string/greeting_default"
                    android:textColor="@color/text_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/emailTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/nunito_normal"
                    android:maxLines="1"
                    android:text="@string/email_default"
                    android:textColor="@color/haai_on_primary_muted"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ageTvm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_normal"
                        android:maxLines="2"
                        android:text="00 Years"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>


            <ImageView
                android:id="@+id/btnLogout"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/color_white_alpha"
                android:clickable="true"
                android:contentDescription="@string/cd_logout"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_logout"
                android:tint="@color/text_white" />
        </LinearLayout>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- 1. Primary action: health awareness report -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/primary_blue_dark"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="96dp"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:importantForAccessibility="no"
                        android:padding="3dp"
                        android:src="@drawable/ic_symptomcheck" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_normal"
                            android:text="@string/check_symptoms_title"
                            android:textColor="@color/text_white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/nunito_normal"
                            android:text="@string/check_symptoms_subtitle"
                            android:textColor="@color/haai_on_primary_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/text_white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PILL TRACKER SECTION (replaces section "2. Pill Tracker entry point").
     Add xmlns:tools="http://schemas.android.com/tools" to the root LinearLayout.

     Two states, switched in code:
       - pillNextGroup  : user has medicines -> big "next dose" hero panel + daily progress
       - pillEmptyGroup : no medicines yet   -> friendly empty state + Add button
     Kept IDs: cardPillTracker, pillSubtitleTv, pillTitleTv, btnAddMedicineHome -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPillTracker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/pill_card_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/pill_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ───────── Header ───────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_haai_circle"
                            android:backgroundTint="@color/pill_icon_bg"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_pilltrack" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_normal"
                            android:text="@string/pill_tracker_title"
                            android:textColor="@color/haai_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/pillViewAllTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_chevron_right"
                            android:drawablePadding="2dp"
                            android:drawableTint="@color/pill_icon_tint"
                            android:fontFamily="@font/nunito_normal"
                            android:gravity="center_vertical"
                            android:text="@string/pill_view_all"
                            android:textColor="@color/pill_icon_tint"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ───────── STATE A: next dose ───────── -->
                    <LinearLayout
                        android:id="@+id/pillNextGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="">

                        <!-- Hero panel: this is the thing that must grab attention -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_pill_next_panel"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/nunito_normal"
                                    android:letterSpacing="0.12"
                                    android:text="@string/pill_next_dose_label"
                                    android:textColor="@color/pill_on_panel_muted"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <!-- Countdown chip: amber so it pops against the blue panel -->
                                <TextView
                                    android:id="@+id/pillCountdownTv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_chip"
                                    android:fontFamily="@font/nunito_normal"
                                    android:paddingStart="10dp"
                                    android:paddingTop="4dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="4dp"
                                    android:textColor="@color/pill_chip_text"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:text="in 2h 15m" />
                            </LinearLayout>

                            <!-- Big time -->
                            <TextView
                                android:id="@+id/pillTimeTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/nunito_normal"
                                android:textColor="@color/pill_on_panel"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:text="07:00 AM" />

                            <!-- Medicine name (was pillTitleTv: "Next: Paracetamol at 07:00") -->
                            <TextView
                                android:id="@+id/pillTitleTv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/nunito_normal"
                                android:maxLines="1"
                                android:textColor="@color/pill_on_panel"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:text="Paracetamol 500 mg" />

                            <!-- Dose + instruction -->
                            <TextView
                                android:id="@+id/pillDoseTv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/nunito_normal"
                                android:maxLines="1"
                                android:textColor="@color/pill_on_panel_muted"
                                android:textSize="13sp"
                                android:text="1 tablet · After food" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMarkTaken"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:fontFamily="@font/nunito_normal"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="48dp"
                                android:text="@string/pill_mark_taken"
                                android:textAllCaps="false"
                                android:textColor="@color/primary_blue_dark"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/pill_on_panel"
                                app:cornerRadius="14dp"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconTint="@color/primary_blue_dark" />
                        </LinearLayout>

                        <!-- Today's progress -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/nunito_normal"
                                android:text="@string/pill_today_label"
                                android:textColor="@color/haai_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/pillProgressTv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_normal"
                                android:textColor="@color/haai_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:text="2 of 4 taken" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/pillProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            app:indicatorColor="@color/pill_progress"
                            app:trackColor="@color/pill_progress_track"
                            app:trackCornerRadius="6dp"
                            app:trackThickness="8dp"
                            android:progress="50" />
                    </LinearLayout>

                    <!-- ───────── STATE B: empty ───────── -->
                    <LinearLayout
                        android:id="@+id/pillEmptyGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_pill_empty_panel"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/pillSubtitleTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_normal"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.15"
                            android:text="@string/pill_tracker_subtitle_empty"
                            android:textColor="@color/haai_text_secondary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddMedicineHome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/nunito_normal"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="48dp"
                            android:text="@string/pill_add_medicine"
                            android:textAllCaps="false"
                            android:textColor="@color/text_white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary_blue_dark"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconTint="@color/text_white" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Secondary actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/haai_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/haai_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_demography" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/nunito_normal"
                            android:text="@string/reports_title"
                            android:textColor="@color/haai_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/haai_emergency_soft"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/haai_emergency_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_emergency" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/nunito_normal"
                            android:text="@string/emergency_title"
                            android:textColor="@color/haai_emergency"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 4. Daily health tip (content, not an action, so it sits lower and lighter) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/primary_blue_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@drawable/card_glaze_overlay"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tipLabelTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_normal"
                        android:text="@string/health_tip_label"
                        android:textColor="@color/haai_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/buttonGenerate"
                        app:layout_constraintEnd_toStartOf="@+id/buttonGenerate"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/buttonGenerate" />

                    <ImageView
                        android:id="@+id/buttonGenerate"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/bg_haai_circle"
                        android:clickable="true"
                        android:contentDescription="@string/cd_new_tip"
                        android:focusable="true"
                        android:padding="5dp"
                        android:src="@drawable/ic_renew"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/healthTipCardIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_main"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/buttonGenerate" />

                    <TextView
                        android:id="@+id/tipTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/nunito_normal"
                        android:lineSpacingMultiplier="1.1"
                        android:text="@string/health_tip_default"
                        android:textColor="@color/text_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/healthTipCardIcon"
                        app:layout_constraintTop_toTopOf="@id/healthTipCardIcon" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Reference link, lowest emphasis -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/haai_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/haai_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_haai_circle"
                        android:backgroundTint="@color/haai_accent_soft"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_info"
                        android:tint="@color/primary_blue_dark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_normal"
                            android:text="@string/gov_info_title"
                            android:textColor="@color/haai_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/nunito_normal"
                            android:text="@string/gov_info_subtitle"
                            android:textColor="@color/haai_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/haai_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>