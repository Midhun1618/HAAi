<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SymptomsActivity">

    <!-- Header -->

    <TextView
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/nunito_normal"
        android:textFontWeight="900"
        android:text="How are you feeling?"
        android:textColor="@color/primary_blue_dark"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/subtitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/nunito_normal"
        android:textFontWeight="400"
        android:text="Select all the symptoms you are currently experiencing."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleTv" />


    <!-- Scrollable Content -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="88dp"
        app:layout_constraintTop_toBottomOf="@id/subtitleTv"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">


            <!-- Symptoms Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Your Symptoms"
                    android:fontFamily="@font/nunito_normal"
                    android:textFontWeight="800"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/selectedCountTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/symptom_count_bg"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="0 selected"
                    android:textColor="@color/primary_blue_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Symptoms Container -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/symptoms_container_bg"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="12dp">


                <!-- Row 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/symp1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:paddingVertical="16dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/unselected"
                        android:text="Fever"
                        android:fontFamily="@font/nunito_normal"
                        android:textFontWeight="500"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/symp6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:paddingVertical="16dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/unselected"
                        android:text="Vomiting"
                        android:fontFamily="@font/nunito_normal"
                        android:textFontWeight="500"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>


                <!-- Row 2 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/symp2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:paddingVertical="16dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/unselected"
                        android:text="Cough"
                        android:fontFamily="@font/nunito_normal"
                        android:textFontWeight="500"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/symp7"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:paddingVertical="16dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/unselected"
                        android:text="Diarrhea"
                        android:fontFamily="@font/nunito_normal"
                        android:textFontWeight="500"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>


                <!-- Row 3 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/symp3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:paddingVertical="16dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/unselected"
                        android:text="Headache"
                        android:fontFamily="@font/nunito_normal"
                        android:textFontWeight="500"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/symp8"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:paddingVertical="16dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/unselected"
                        android:text="Fatigue"
                        android:fontFamily="@font/nunito_normal"
                        android:textFontWeight="500"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>


                <!-- Row 4 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/symp4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:paddingVertical="16dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/unselected"
                        android:text="Body Pain"
                        android:fontFamily="@font/nunito_normal"
                        android:textFontWeight="500"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/symp9"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:paddingVertical="16dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/unselected"
                        android:text="Sore Throat"
                        android:fontFamily="@font/nunito_normal"
                        android:textFontWeight="500"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>


                <!-- Row 5 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/symp5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:paddingVertical="16dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/unselected"
                        android:text="Nausea"
                        android:fontFamily="@font/nunito_normal"
                        android:textFontWeight="500"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/symp10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:paddingVertical="16dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/unselected"
                        android:text="Chest Pain"
                        android:fontFamily="@font/nunito_normal"
                        android:textFontWeight="500"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- Details Section -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/nunito_normal"
                android:textFontWeight="800"
                android:text="A Few More Details"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- Duration and Age -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">


                <!-- Duration -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_card_bg"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Duration"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/durationEt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="Days"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                </LinearLayout>


                <!-- Age -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_card_bg"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Age"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/ageEt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="Years"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- Additional Information -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/nunito_normal"
                android:textFontWeight="800"
                android:text="Additional Information (Optional)"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/additionalInput"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/additional_input_bg"
                android:gravity="top|start"
                android:fontFamily="@font/nunito_normal"
                android:textFontWeight="500"
                android:hint="Anything else you'd like to mention? For example: symptoms started after eating outside..."
                android:inputType="textMultiLine|textCapSentences"
                android:padding="16dp"
                android:textColor="@color/text_secondary"
                android:textColorHint="#8A94A6"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- Bottom Action -->

    <Button
        android:id="@+id/checkNow"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/primary_blue"
        android:elevation="6dp"
        android:fontFamily="@font/nunito_normal"
        android:textFontWeight="800"
        android:text="Check My Symptoms"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>